# ZUUP-OS mount table (spec §7.3) — read-only root, every write to RAM.
#
# The SquashFS root is mounted read-only behind dm-verity (§7.1/§7.3); the only
# writable surfaces are tmpfs overlays that live in RAM and vanish at power-off.
# This is what makes INV-1 (`remount,rw /` fails) and INV-2 (power-cycle →
# forensic zero) true: there is no writable persistent medium in the trust path.
#
# Mount flags are maximally restrictive: nosuid,nodev everywhere; noexec on every
# scratch area that does not legitimately run code.

# <device>            <mount point>   <type>     <options>                                   <dump> <pass>
/dev/mapper/zuup-root  /              squashfs   ro,nosuid,nodev                              0      0
tmpfs                  /tmp           tmpfs      rw,nosuid,nodev,noexec,size=256m,mode=1777   0      0
tmpfs                  /run           tmpfs      rw,nosuid,nodev,noexec,size=64m,mode=0755     0      0
tmpfs                  /var/log       tmpfs      rw,nosuid,nodev,noexec,size=64m,mode=0755     0      0
tmpfs                  /run/firefox   tmpfs      rw,nosuid,nodev,noexec,size=512m,mode=0700    0      0
# webcam capture buffers: RAM only, zeroised on unmount (DPDP §8.4)
tmpfs                  /run/biometric tmpfs      rw,nosuid,nodev,noexec,size=128m,mode=0700    0      0
# Runtime identity material for a machine that commissions ITSELF (the all-in-one
# variant only — zuup-commission.sh): its station ids, its biometric daemon key,
# its TPM attestation-key context. A production terminal carries these inside its
# signed image and never touches this mount, because /etc is on the read-only
# verity root — which is exactly why self-commissioning needs somewhere else to
# put them. RAM only, so the keys die with the power (INV-2) and the machine
# re-registers from scratch on the next boot. mode 0755: the roles file has to
# be readable by the portal services; the private key inside is 0640 root:zuup-bio.
tmpfs                  /run/zuup-identity tmpfs  rw,nosuid,nodev,noexec,size=4m,mode=0755      0      0
# /proc with hidepid=2 so no process can see another's command line/env (§7.3)
proc                   /proc          proc       rw,nosuid,nodev,noexec,hidepid=2              0      0
# EFI variables READ-ONLY. systemd mounts efivarfs read-write by default, which
# gives anything running as root a path to the firmware's NVRAM.
#
# A terminal has no legitimate reason to write one: boot order, Secure Boot keys
# and the boot entries are all set by the authority before the machine is
# deployed, and INV-2 says the machine remembers nothing across a power cycle —
# an EFI variable is the one store on the box that would survive.
#
# It is also a real destruction risk on some hardware. Samsung laptops of the
# 2011-2012 generation were bricked by exactly this: EFI variable writes filled
# NVRAM and the machine never booted again. The kernel has refused writes below
# 50% free space since 3.x, so this is belt-and-braces on a 6.6 kernel — but the
# braces cost nothing and the failure is unrecoverable.
efivarfs               /sys/firmware/efi/efivars  efivarfs  ro,nosuid,nodev,noexec,noauto     0      0
