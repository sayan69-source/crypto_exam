# ZUUP-OS kiosk unit (spec §7.4, §7.5) — systemd → Cage → Firefox, no escape.
#
# Cage is a single-surface Wayland compositor: it refuses every additional
# wl_surface, so no second window, overlay, or screenshot-of-another-window can
# exist. Firefox launches --kiosk at the Edge. The hardening directives below
# are the systemd half of the §7.5 runtime enforcement (the AppArmor + seccomp
# halves live alongside this file). Restart=always: there is no way to "exit".

[Unit]
Description=ZUUP-OS locked examination surface
# The Gate renders only after the boot is attested (§7.1) and the biometric
# daemon is serving — and never without the tunnel (INV-3, INV-10).
# Cage needs a seat manager (seatd) to take the DRM display + input — logind is
# masked on this image, so seatd is the one that hands cage the seat.
After=zuup-network.target zuup-attest.service zuup-biometric.service seatd.service
Requires=zuup-network.target zuup-attest.service seatd.service
# Restart=always below is only as good as the rate limiter above it: with the
# default burst systemd would give up after five quick restarts and leave the
# terminal on a black screen with no way back. An examination surface has no
# acceptable "stopped" state — keep trying, forever.
StartLimitIntervalSec=0

[Service]
Type=simple
# Cage owns the only display surface; Firefox is its only child. The launcher
# picks the URL from this terminal's Edge-reported capability (§7.6) so the
# ADMIN_STATION opens the Centre Admin portal, an INVIGILATOR_STATION/
# CANDIDATE_SEAT opens the exam-terminal Gate, and anything else fails closed.
# Cage needs an XDG_RUNTIME_DIR seat and Firefox a writable HOME — both RAM-only
# (INV-2): /run/firefox via RuntimeDirectory, the profile under PrivateTmp's /tmp.
Environment=XDG_RUNTIME_DIR=/run/firefox
Environment=HOME=/tmp/firefox
# The kernel ships WITHOUT user namespaces (a deliberate hardening — unprivileged
# userns is an escalation vector). Firefox's content/GPU sandboxes rely on userns,
# so disable them: the kiosk only ever loads the single trusted Edge origin on an
# air-gapped LAN, so there is no untrusted web content to isolate from anyway.
Environment=MOZ_DISABLE_CONTENT_SANDBOX=1
Environment=MOZ_DISABLE_GMP_SANDBOX=1
# Cage is a Wayland compositor and this image ships no X server and no Xwayland.
# Firefox picks its GDK backend at startup and only defaults to Wayland on newer
# builds, so an ESR that guessed X11 would exit with "cannot open display" and
# crash-loop behind a black screen. Pin the backend rather than depend on the
# browser's default.
Environment=MOZ_ENABLE_WAYLAND=1
Environment=GDK_BACKEND=wayland
Environment=XDG_SESSION_TYPE=wayland
# wlroots refuses a software renderer unless told otherwise. On a terminal whose
# GPU has no in-kernel driver the display still exists (simpledrm over the UEFI
# framebuffer) but EGL has no hardware to bind — allowing llvmpipe is what keeps
# the kiosk on screen instead of dying at compositor start. The launcher falls
# back further, to the pixman renderer, if cage still exits immediately.
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
ExecStartPre=/bin/mkdir -p /tmp/firefox
ExecStart=/usr/lib/zuup/zuup-kiosk-launch.sh
Restart=always
RestartSec=1

# ── §7.5 runtime hardening ───────────────────────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# AF_NETLINK is required by wlroots/libudev to enumerate + monitor the DRM and
# input devices (cage fails "session udev monitor: Address family not supported"
# without it). It is local kernel<->user comms, not a network egress path, so the
# air-gap is unaffected.
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
LockPersonality=yes
# W^X (MemoryDenyWriteExecute) is intentionally NOT set: a browser engine needs
# writable-then-executable mappings (graphics/regex/interp trampolines) even with
# the JS JIT off, and Firefox crashes under strict W^X. The remaining hardening —
# read-only verity root, no shell, seccomp, AppArmor, lockdown LSM, air-gap —
# still stands; this only lifts W^X for the browser surface.
# ── seccomp (§7.5) ───────────────────────────────────────────────────────────
#
# This is the whole of the syscall enforcement, and it is the real thing — a
# kernel seccomp-bpf filter installed by systemd before exec.
#
# It replaces security/seccomp/firefox.json, which was installed to
# /etc/zuup/firefox-seccomp.json and read by NOTHING: `SystemCallFilter=` takes
# systemd syscall-set names, never a path to an OCI seccomp document, so the
# file was inert. It would also not have worked if something had loaded it — its
# default action was KILL_PROCESS over an allow-list of 50 syscalls, and a
# browser needs several hundred, so the first frame Firefox rendered would have
# killed it. The useful half of that file was its explicit kill list, and every
# entry of it is reproduced below.
#
# The base allow-list. @system-service already excludes @clock, @cpu-emulation,
# @debug, @module, @mount, @obsolete, @privileged, @raw-io, @reboot and @swap.
SystemCallFilter=@system-service
SystemCallArchitectures=native
# Denied syscalls return EPERM rather than killing the process, and that is a
# deliberate departure from firefox.json's KILL_PROCESS default.
#
# systemd can kill per-syscall (`SystemCallFilter=~ptrace:kill`), and for a
# server it would be the right choice. This is an examination terminal: a kill
# on a false positive is a candidate losing their seat mid-paper, with no shell,
# no second window and an invigilator who cannot do anything about it. EPERM
# denies the operation just as completely — the syscall does not happen — and
# fails the attempt instead of the exam. The layers that would actually contain
# a live exploit (read-only verity root, AppArmor, lockdown, the air-gap) do not
# depend on which of the two this is.
SystemCallErrorNumber=EPERM
# The explicit kill list, carried over verbatim from firefox.json. Most are
# already covered by the exclusions above; naming them is what makes the policy
# legible and survives a future change to what @system-service contains.
#
# ptrace/process_vm_* — reading another process's memory is the move that turns
# a browser compromise into a compromise of the biometric daemon next to it.
# userfaultfd is not in any systemd group and is a well-worn kernel-exploit
# primitive, so it is worth naming on its own.
SystemCallFilter=~@debug @mount @reboot @swap @obsolete @module @raw-io
SystemCallFilter=~ptrace process_vm_readv process_vm_writev
SystemCallFilter=~kexec_load kexec_file_load init_module finit_module
SystemCallFilter=~mount umount2 pivot_root chroot
SystemCallFilter=~bpf perf_event_open userfaultfd
SystemCallFilter=~setuid setgid reboot swapon swapoff
# Writable surfaces are tmpfs only (RAM; INV-2). RuntimeDirectory creates
# /run/firefox at start (0700, auto-removed on stop); PrivateTmp gives a fresh
# private /tmp tmpfs for the Firefox profile. These EXIST before the sandbox is
# wired, unlike a ReadWritePaths bind of a not-yet-created /tmp/firefox — which
# is what made systemd fail at 226/NAMESPACE and crash-loop the kiosk.
RuntimeDirectory=firefox
RuntimeDirectoryMode=0700
PrivateTmp=yes
# VT switching is disabled at logind; Cage takes the only seat.
TTYVTDisallocate=yes

[Install]
WantedBy=zuup-session.target
