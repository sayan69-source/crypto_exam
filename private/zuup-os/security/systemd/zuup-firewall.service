# ZUUP-OS firewall loader (spec §6.3) — default-drop BEFORE any interface is
# configured. Ordered Before=network-pre.target so there is no window in which
# an interface exists without the drop policy (isolation layer #4 of §6.2).

[Unit]
Description=ZUUP-OS nftables default-drop ruleset
DefaultDependencies=no
Before=network-pre.target zuup-wireguard.service
Wants=network-pre.target
# The ruleset includes /run/zuup-identity/nftables.d/*.nft — the Edge peer, and
# on an ADMIN_STATION the HQ destinations — which zuup-identity.service derives
# from the signed cmdline. Loading before those files exist yields a terminal
# that cannot reach its centre, and an admin station with no uplink on the one
# day it needs one. Requires=, not Wants=: if identity cannot be published there
# is nothing safe to load.
After=zuup-identity.service
Requires=zuup-identity.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/zuup/nftables.conf
# re-assert on reload; never flush to permissive
ExecReload=/usr/sbin/nft -f /etc/zuup/nftables.conf
# Fail-closed: if the default-drop ruleset cannot load, the terminal must go
# dark, never continue toward the Gate with an unknown firewall state.
FailureAction=poweroff-force

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=zuup-network.target
