# Single-origin reverse proxy — the heart of the all-in-one. The kiosk Firefox
# loads ONE origin (https://edge.local in production; http://localhost:8080
# here) and this routes the three surfaces behind it, so the portal code's
# same-origin `/api/*` and the `/admin/` hand-off work without CORS, exactly as
# they will inside the bundled image.
#
# `handle` blocks are mutually exclusive and matched most-specific-first, so
# /api and /admin win over the catch-all that serves the exam terminal.
{
	admin off
	auto_https off
}

:8080 {
	# Document root for every static response below (the /kiosk surfaces and the
	# error page). The reverse-proxied routes never consult it.
	root * /srv/kiosk

	# §13 Centre Edge API (Fastify). Both portals call same-origin /api/*.
	handle /api/* {
		reverse_proxy edge:4000
	}

	# The operator role chooser + the origin liveness beacon, served straight
	# off disk so they answer before any Node service has booted. Same files,
	# same path as the image serves from /opt/zuup/www — this proving ground
	# exists to be the same bytes, so it routes them the same way.
	redir /kiosk /kiosk/ 308
	handle /kiosk/* {
		uri strip_prefix /kiosk
		file_server
	}

	# Centre Admin portal (Next, built with basePath /admin). The prefix is
	# NOT stripped — the app expects to live under /admin.
	handle /admin* {
		reverse_proxy centre-admin:3002
	}

	# Everything else → the exam-terminal Login Gate, candidate + invigilator
	# seats, and the /locked fail-closed wall.
	handle {
		reverse_proxy exam-terminal:3000
	}

	# An upstream that is not listening yet gets the "centre starting" page
	# rather than a bare 502 the browser would sit on. The marker header is what
	# lets that page tell a real upstream 200 from its own.
	handle_errors {
		header X-Zuup-Starting 1
		rewrite * /starting.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
