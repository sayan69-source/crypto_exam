# Production image for the public website (Render / any Docker host).
# Builds the app (NEXT_PUBLIC_* are inlined at build time) and serves via
# the standalone Node.js server — no npm, no node_modules in the runtime image.

# ── Stage 1: build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

# NEXT_PUBLIC_* must be present at BUILD time — Next inlines them into the
# client bundle. Set NEXT_PUBLIC_API_URL to the deployed backend's URL.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_USE_MOCK=false
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_USE_MOCK=${NEXT_PUBLIC_USE_MOCK}

RUN npm run build

# ── Stage 2: production runtime ───────────────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# Render injects $PORT; default to 3000 locally.
CMD ["sh", "-c", "PORT=${PORT:-3000} node server.js"]
