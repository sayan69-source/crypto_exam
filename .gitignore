!*.key.example

# Circuit build artifacts.
#
# The proving key, verifying key and witness calculators ARE tracked: the
# Groth16Verifier in contracts/src/ZKVerifier.sol is exported from one specific
# proving key, so a fresh `build.sh` run would produce keys that the deployed
# verifier rejects. Shipping the keys keeps "clone it and the proof verifies"
# true, and keeps the on-chain verifier matched to them.
#
# Intermediates (the ceremony transcript, r1cs, symbol table, pre-contribution
# zkey) are large and rebuildable, so they stay out.
#
# `build/` above would otherwise swallow the whole directory before any of the
# rules below are reached — git does not descend into an excluded directory.
!public/circuits/build/
public/circuits/build/*.wtns
public/circuits/build/pot*.ptau
public/circuits/build/*.r1cs
public/circuits/build/*.sym
public/circuits/build/difficulty_proof_0000.zkey

# Python
*.egg
*.egg-info/
.pytest_cache/
htmlcov/
.coverage

# Hardhat
public/contracts/artifacts/
public/contracts/cache/
public/contracts/typechain-types/

# Engine corpus (large, downloaded separately)
public/backend/engine/corpus/*.parquet

# Logs
*.log
logs/

# IPFS
ipfs_data/
scripts/out/

# ZUUP-OS image pipeline artifacts (multi-GB: disk image, kernel tree, UKI)
private/zuup-os/image-build/out/

# ZUUP-OS terminal walkthrough zip (local demo only, never tracked)
zuup-os-terminal.zip

# ── ZK circuit build artifacts ──
# The final proving key, verification key, r1cs and witness generator ARE
# committed: the zkey and contracts/src/ZKVerifier.sol must move together or
# on-chain verification silently breaks (see public/circuits/README-ZK.md).
# The Powers-of-Tau files are 31 MB of regenerable ceremony input — rebuild
# them with `npm run build` in public/circuits rather than storing them.
public/circuits/build/*.ptau
public/circuits/build/difficulty_proof_0000.zkey
public/circuits/build/*.sym

# ── Centre provisioning bundles (§12) ──
# Real rosters, real staff enrolment hashes and real terminal attestation keys.
# The Edge is commissioned from one of these (private/edge-server/src/provision.ts);
# they are operational data for a specific centre, never repository content.
private/all-in-one/provisioning/
*.centre-bundle.json
